# ---- basics ----
PORT=4000
# Signs login sessions. Leave empty and the server generates a strong secret on
# first start and keeps it next to the database (data/jwt-secret). Set it
# explicitly when you run more than one copy or want to control rotation.
JWT_SECRET=
DB_PATH=./data/swiftride.db
# Extra browser origins allowed to call this API (comma separated). The site
# served by this server and the native phone app need no entry.
CLIENT_ORIGIN=

# ---- maps (free public servers; replace with your own for production) ----
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim asks for an identifying User-Agent with a contact; VAPID_SUBJECT is used when this is empty.
USER_AGENT=

# ---- dispatch ----
DISPATCH_OFFER_SECONDS=20
DISPATCH_RADII_KM=3,6,10
DISPATCH_DRIVERS_PER_WAVE=3
DISPATCH_MAX_WAVES=3

# ---- payments ----
# mock = built-in test gateway, no account, no real money (default).
# razorpay = real cards/UPI; fill in the two keys from your Razorpay dashboard.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
COMMISSION_PERCENT=10

# ---- push notifications (free) ----
# Run: npm run push:keys   then paste the two lines it prints here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- demo accounts ----
# An empty database gets the demo accounts (customer@demo.com, driver@demo.com, ...).
# SEED_DEMO=0 skips them and creates only an admin (password printed once in the log,
# or ADMIN_PASSWORD). DEMO_PASSWORD replaces the well-known "password" for every demo
# account; the login page stops printing the password once it is changed.
SEED_DEMO=1
DEMO_PASSWORD=
ADMIN_PASSWORD=

# ---- company and settlement ----
# The company QR a rider pays at the end of a cash ride encodes this UPI ID.
COMPANY_NAME=SwiftRide
COMPANY_UPI_ID=swiftride@upi
# The owner sees the company books, every account and wallet, and pays drivers.
OWNER_EMAILS=owner@demo.com
# "I've arrived" only counts within this distance of the pickup.
ARRIVAL_RADIUS_KM=1
# In-app calls across different networks need a TURN relay. Open Relay (free) is
# the default; set your own, or TURN_URLS= (empty) for STUN only.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- operations ----
# 1 = new drivers must be approved by an admin before going online.
REQUIRE_DRIVER_APPROVAL=0
ADMIN_EMAILS=admin@demo.com
UPLOAD_DIR=./data/uploads
